# Normalize line endings so the repo doesn't churn when you switch
# between the Windows desktop, the Lenovo, and the MacBook.

* text=auto eol=lf

# Windows-only tooling that genuinely wants CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf

# Scripts that must stay LF even on Windows
*.sh        text eol=lf
Dockerfile  text eol=lf

# Binary — never diff or convert
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary

# Collapse lockfile diffs in review
package-lock.json  -diff linguist-generated
yarn.lock          -diff linguist-generated
pnpm-lock.yaml     -diff linguist-generated
