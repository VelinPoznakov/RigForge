{
  "ConnectionStrings": {
    "Database": ""
  },

  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequireNonAlphanumeric": false
    },
    "User": {
      "RequireUniqueEmail": true
    },
    "SignIn": {
      "RequireConfirmedAccount": false,
      "RequireConfirmedEmail": false
    }
  },

  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Key": "",
    "AccessTokenMinutes": 0
  },

  "Admin": {
    "Email": "",
    "Username": "",
    "Password": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
